@startwbs content-store
skinparam dpi 300
<style>
wbsDiagram {
  FontName Arial
  FontSize 11
  FontColor black
  LineColor black
  LineThickness 1
  BackgroundColor white
  RoundCorner 0
  Shadowing 0
  Padding 6
  Margin 8
  node {
    BackgroundColor white
    LineColor black
    LineThickness 1
  }
  :depth(0) {
    FontSize 12
    LineThickness 1.5
  }
  boxless {
    FontColor black
    Padding 4
    Margin 6
  }
}
</style>
